# Python and common build output
__pycache__/
*.py[cod]
.venv/
build/
dist/
*.egg-info/

# Worktree-local control plane. It is visible in the worktree but not tracked.
.project/

# Local environment and secrets
.env
.env.local
.env.*.local
!.env.example

# Editor and OS files
.DS_Store
.idea/
.vscode/

# Asset payloads and machine-specific links stay local. Keep only the stable
# manifest, documentation and placeholder tracked in the repository.
assets/*
!assets/README.md
!assets/MANIFEST.yaml
!assets/.gitkeep
