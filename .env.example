# The variables the concrete project reads, by name. Never put a token, a
# password or any credential value here. Credentials are listed in
# credentials.yaml and come from the device's shared file through the ignored
# link in .project/credentials/ (llm-credentials); a *_FILE variable points
# inside the project, at that link or a login directory there.

# PROJECT_ENV=development
# PROJECT_CREDENTIAL_FILE=.project/credentials/<name>
